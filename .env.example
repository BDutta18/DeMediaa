# --- Server ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
SERVICE_NAME=demedia-backend
APP_VERSION=1.0.0

# --- Database -----------------------------------------------------------------
# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/demedia?retryWrites=true&w=majority

# --- Auth ---------------------------------------------------------------------
# Secret used to sign/verify JWT tokens — use a long random value in production
JWT_SECRET=change_me_to_a_long_random_secret

# --- Stellar / Soroban -------------------------------------------------------
# Backend's Stellar keypair (secret key — keep private!)
PRIVATE_KEY=S...

# Stellar network passphrase
# Testnet:  Test SDF Network ; September 2015
# Mainnet:  Public Global Stellar Network ; September 2015
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Horizon and Soroban RPC endpoints
HORIZON_URL=https://horizon-testnet.stellar.org
RPC_URL=https://soroban-testnet.stellar.org

# Deployed ContentRegistry contract address
CONTRACT_ADDRESS_CONTENTREGISTRY=

# --- IPFS / Pinata ------------------------------------------------------------
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
